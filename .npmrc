# Allow build scripts for Vercel packages
enable-pre-post-scripts=true
scripts-prepend-node-path=true
ignore-scripts=false
# Specifically allow Vercel packages
allowed-scripts=@vercel/speed-insights,@vercel/analytics
# Force enable scripts for Vercel packages
scripts-prepend-node-path=true
# Additional configuration for pnpm 10.x
auto-install-peers=true
